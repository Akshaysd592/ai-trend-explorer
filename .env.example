# ============================================================
# AI Trend Explorer — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git — it's in .gitignore.
# ============================================================

# ── JWT ──────────────────────────────────────────────────────
# Must be at least 256 bits (32 characters). Shared between
# auth-service and trend-service.
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=replace-this-with-a-strong-256-bit-secret

# ── Database ─────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/trend_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgrespassword

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Gemini AI ────────────────────────────────────────────────
GEMINI_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# ── GitHub Ingestion ─────────────────────────────────────────
GITHUB_TOKEN=your-github-personal-access-token-here

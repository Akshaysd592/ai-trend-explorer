# ============================================================
# AI Trend Explorer — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git — it's already in .gitignore.
#
# Generate a strong JWT secret:
#   PowerShell: -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })
#   Linux/Mac:  openssl rand -hex 32
# ============================================================

# ── JWT ──────────────────────────────────────────────────────
# Shared between auth-service and trend-service. Min 256 bits.
JWT_SECRET=replace-this-with-a-strong-256-bit-secret

# ── PostgreSQL Database ───────────────────────────────────────
POSTGRES_DB=trend_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-db-password

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/trend_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace-with-strong-db-password

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Apache Kafka ─────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Gemini AI ────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# ── GitHub Ingestion ─────────────────────────────────────────
# Generate at: https://github.com/settings/tokens
# Required scope: public_repo (read-only)
GITHUB_TOKEN=replace-with-your-github-personal-access-token

# ── Service URLs (for Docker / prod overrides) ───────────────
AUTH_SERVICE_URL=http://localhost:8082
TREND_SERVICE_URL=http://localhost:8081

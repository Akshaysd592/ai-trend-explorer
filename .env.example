# ============================================================
# AI Trend Explorer — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git — it's already in .gitignore.
#
# Generate a strong JWT secret:
#   PowerShell: -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })
#   Linux/Mac:  openssl rand -hex 32
# ============================================================

# ── Docker Compose ────────────────────────────────────────────
COMPOSE_PROJECT_NAME=ai-trend-explorer

# ── JWT ──────────────────────────────────────────────────────
# Shared between auth-service and trend-service. Min 256 bits.
JWT_SECRET=replace-this-with-a-strong-256-bit-secret

# ── trend-service PostgreSQL ──────────────────────────────────
POSTGRES_DB=trend_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-trend-db-password

# Used when running locally outside Docker
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/trend_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace-with-strong-trend-db-password

# ── auth-service PostgreSQL ───────────────────────────────────
AUTH_POSTGRES_DB=auth_db
AUTH_POSTGRES_USER=postgres
AUTH_POSTGRES_PASSWORD=replace-with-strong-auth-db-password

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Apache Kafka (Aiven for Apache Kafka) ────────────────────────────────────
# Sign up at: https://console.aiven.io/signup (free tier — no credit card needed)
# Get values from: Aiven Console → Kafka Service → Overview / Connection information
# KAFKA_SECURITY_PROTOCOL / KAFKA_SASL_MECHANISM are set automatically in render.yaml
KAFKA_BOOTSTRAP_SERVERS=kafka-xxxxx.aivencloud.com:26042
KAFKA_SASL_USERNAME=avnadmin
KAFKA_SASL_PASSWORD=replace-with-aiven-service-user-password
# Defaults to PLAINTEXT for local Docker Compose (Kafka runs in-cluster)
# Override to SASL_SSL / SCRAM-SHA-256 when connecting to Aiven Kafka
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-256

# ── Gemini AI ────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash-lite

# ── GitHub Ingestion ─────────────────────────────────────────
# Generate at: https://github.com/settings/tokens
# Required scope: public_repo (read-only)
GITHUB_TOKEN=replace-with-your-github-personal-access-token

# ── Service URLs (override for local dev without Docker) ─────
AUTH_SERVICE_URL=http://localhost:8082
TREND_SERVICE_URL=http://localhost:8081
AI_ANALYSIS_SERVICE_URL=http://localhost:8083

# ── Render Deployment ─────────────────────────────────────────
# Set ALLOWED_ORIGINS to your Render frontend URL after deploy
# Example: https://ai-trend-explorer-frontend.onrender.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
